{
  "apiVersion": 3,
  "name": "lone-pine-digital/hero-simple",
  "title": "Lone Pine Digital - Hero Simple",
  "category": "design",
  "icon": "cover-image",
  "description": "A simple hero block with an image and a heading.",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "attributes": {
        "scheme": {
          "type": "string",
          "default": "eggshell"
        },
        "imageUrl": {
          "type": "string",
          "default": ""
        },
        "heading": {
          "type": "string",
          "source": "html",
          "selector": "h1",
          "default": "Page Title"
        },
        "subheading": {
          "type": "string",
          "source": "html",
          "selector": "p",
          "default": "This is a simple hero block with a heading and an optional image."
        },
        "supports": {
          "spacing": false,
          "align": false,
          "typography": false,
          "color": false
        }
      }
}   