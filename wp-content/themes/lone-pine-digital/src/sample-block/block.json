{
  "apiVersion": 3,
  "name": "lone-pine-digital/sample-block",
  "title": "Lone Pine Digital - Sample Block",
  "category": "design",
  "icon": "format-image",
  "description": "A sample block for demonstration purposes.",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "attributes": {
        "scheme": {
          "type": "string",
          "default": "white"
        },
        "imageUrl": {
          "type": "string",
          "default": ""
        },
        "heading": {
          "type": "string",
          "source": "html",
          "selector": "h2",
          "default": "Section Title"
        }
      },
      "supports": {
          "spacing": false,
          "align": false,
          "typography": false,
          "color": false
      }
}   