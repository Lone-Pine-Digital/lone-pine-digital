##############################
# Node / NPM
##############################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
.cache/
.pnp/
.pnp.js

##############################
# WordPress (theme/plugin dev)
##############################
# Ignore WordPress core
wp-admin/
wp-includes/

# Ignore uploads (large, not versioned)
wp-content/uploads/

# Ignore cache
wp-content/cache/
wp-content/backups/
wp-content/upgrade/

# Ignore environment-specific configs
wp-config.php
wp-config-local.php
wp-content/debug.log

# Ignore WordPress-installed plugins/themes
wp-content/plugins/*
wp-content/themes/*

# BUT keep your custom theme/plugin
!wp-content/themes/lone-pine-digital/
!wp-content/plugins/lone-pine-digital/

##############################
# Hostinger / Server
##############################
# Logs
*.log
logs/
error_log

# System files
.htaccess
web.config

##############################
# GitHub Actions
##############################
# Ignore workflow temp files
.github/workflows/*.tmp

##############################
# VS Code
##############################
.vscode/
*.code-workspace

##############################
# OS Junk Files
##############################
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

##############################
# Misc
##############################
.env
.env.local
.env.*.local
*.env
*.zip
*.tar.gz
*.tmp